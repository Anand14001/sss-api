# Salem Star Speaker Backend Environment Configuration

# Server Environment (development | production | test)
NODE_ENV=production
PORT=4000

# PostgreSQL Database Configuration (Prisma ORM)
DATABASE_URL="postgres://username:password@host:5432/database?sslmode=require"

# Razorpay Payment Gateway Credentials
# Obtain these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_or_test_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# cPanel Authenticated SMTP Email Configuration
# Obtain these from your cPanel Email Accounts -> Connect Devices
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your_email_account_password_here
MAIL_FROM_NAME=Salem Star Speaker
MAIL_FROM_ADDRESS=contact@yourdomain.com
MAIL_REPLY_TO=vivek@yourdomain.com

# Allowed CORS Origins (comma-separated list of frontends)
ALLOWED_ORIGINS=https://salemstarspeaker.com,https://www.salemstarspeaker.com,http://localhost:5173

# ---------------------------------------------------------------- Admin dashboard
# Session cookie scope for sss-admin.
# 'lax'  — dashboard and API share a registrable domain (preferred)
# 'none' — entirely different domains; forces Secure, so both must be HTTPS
ADMIN_COOKIE_SAMESITE=lax
# Set only when sharing a parent domain, e.g. .salemstarspeaker.com
ADMIN_COOKIE_DOMAIN=

# One-time administrator provisioning, read ONLY by prisma/seedAdmin.js.
# No request handler reads these. Clear them once the real password is set.
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=change_this_one_time_password
ADMIN_BOOTSTRAP_NAME=Event Administrator
