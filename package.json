{
  "name": "sss-api",
  "version": "1.0.0",
  "description": "Backend API for Salem Star Speaker registration and Razorpay payments",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "migrate": "prisma db push && node prisma/seed.js && node prisma/seedAdmin.js && node prisma/backfill.js",
    "seed:admin": "node prisma/seedAdmin.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.1.1",
    "razorpay": "^2.9.5",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "supertest": "^7.0.0"
  }
}